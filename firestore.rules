rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (getUserData().role == role || getUserData().role == 'SUPER_ADMIN');
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'DIRECTOR', 'ACCOUNTANT', 'TEACHER', 'ATTENDANCE_OPERATOR']
      );
    }

    function isFinancialStaff() {
      return isAuthenticated() && (
        getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'DIRECTOR', 'ACCOUNTANT']
      );
    }

    // Users collection: only Super Admin can write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // Students: read by all staff, write by Admin, Principal, or Accountant
    match /students/{studentId} {
      allow read: if isStaff();
      allow create, update: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // Academic Sessions & Classes: Read by all, write by Admin / Principal
    match /academic_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL']);
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL']);
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL']);
    }

    // Financial records: Fee payments, Income, Expenses - strictly restricted to financial staff
    match /fee_payments/{paymentId} {
      allow read: if isStaff();
      allow create: if isFinancialStaff() &&
        request.resource.data.paidAmount is number &&
        request.resource.data.paidAmount >= 0;
      allow update, delete: if hasRole('SUPER_ADMIN');
    }

    match /payment_details/{detailId} {
      allow read: if isStaff();
      allow create: if isFinancialStaff();
      allow update, delete: if hasRole('SUPER_ADMIN');
    }

    match /fee_categories/{categoryId} {
      allow read: if isStaff();
      allow write: if isFinancialStaff();
    }

    match /fee_structures/{structureId} {
      allow read: if isStaff();
      allow write: if isFinancialStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isFinancialStaff();
      allow create: if isFinancialStaff() &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update, delete: if hasRole('SUPER_ADMIN');
    }

    match /income/{incomeId} {
      allow read: if isFinancialStaff();
      allow create: if isFinancialStaff() &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update, delete: if hasRole('SUPER_ADMIN');
    }

    // Attendance: read by staff, marked by Attendance Operator, Teachers, and Admin
    match /student_attendance/{attId} {
      allow read: if isStaff();
      allow write: if isAuthenticated() && (
        getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'TEACHER', 'ATTENDANCE_OPERATOR']
      );
    }

    match /staff_attendance/{attId} {
      allow read: if isStaff();
      allow write: if isAuthenticated() && (
        getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'ATTENDANCE_OPERATOR']
      );
    }

    // Examinations and Results
    match /examinations/{examId} {
      allow read: if isStaff();
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL']);
    }

    match /exam_results/{resultId} {
      allow read: if isStaff();
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL', 'TEACHER']);
    }

    // Notices: Public read, write by Admin & Principal
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated() && (getUserData().role in ['SUPER_ADMIN', 'PRINCIPAL']);
    }

    // Audit logs: Append-only by authenticated staff, read-only by Super Admin
    match /audit_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN');
      allow create: if isStaff();
      allow update, delete: if false; // Append-only immutable log
    }

    // Settings
    match /institution_settings/{settingId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN');
    }
  }
}
